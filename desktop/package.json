{
  "name": "kingdom-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Kingdom Native Desktop Application Shell",
  "homepage": "https://github.com/wests-cmd/kingdom",
  "author": {
    "name": "Kingdom Maintainers",
    "email": "westd613@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.wests-cmd.kingdom",
    "productName": "Kingdom",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Kingdom Maintainers <westd613@gmail.com>"
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ]
  }
}
