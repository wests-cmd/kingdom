{
  "name": "kingdom-desktop",
  "private": true,
  "version": "1.0.1",
  "description": "Kingdom Native Desktop Application Shell",
  "homepage": "https://github.com/wests-cmd/kingdom",
  "author": {
    "name": "Kingdom Maintainers",
    "email": "westd613@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.wests-cmd.kingdom",
    "productName": "Kingdom",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Kingdom-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "Kingdom-${version}.${ext}",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Kingdom Maintainers <westd613@gmail.com>"
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../configs/install_profiles.json",
        "to": "configs/install_profiles.json"
      }
    ]
  }
}
